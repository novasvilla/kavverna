# Maintainer: novasvilla <https://github.com/novasvilla>

pkgname=kavverna
pkgver=0.1.1
pkgrel=1
pkgdesc="One tray icon for the utilities a KDE Plasma desktop is missing"
arch=('x86_64')
url="https://github.com/novasvilla/kavverna"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'layer-shell-qt' 'libpipewire' 'sqlite' 'hicolor-icon-theme')
makedepends=('rust' 'clang' 'pkgconf')
optdepends=('ydotool: synthetic paste, once a feature asks for it')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1753651c842951c58d5b33421904f0ad3aad106eb2f8011216a1f18fbc3baf1b')

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen --locked
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Only the library tests. The rest talk to a live compositor and a live session bus, which a
  # build chroot does not have.
  cargo test --frozen --release --lib \
    -p feature-catalog -p feature-runtime -p preferences \
    -p keep-awake -p clipboard-history -p link-cleaner \
    -p sound-mixer -p system-monitor
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/kavverna-shell "$pkgdir/usr/bin/kavverna-shell"
  install -Dm644 packaging/dev.kavverna.Kavverna.desktop \
    "$pkgdir/usr/share/applications/dev.kavverna.Kavverna.desktop"
  install -Dm644 docs/assets/logo.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.kavverna.Kavverna.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
