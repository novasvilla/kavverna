# Maintainer: novasvilla <https://github.com/novasvilla>

pkgname=kavverna
pkgver=0.1.5
pkgrel=1
pkgdesc="One tray icon for the utilities a KDE Plasma desktop is missing"
arch=('x86_64')
url="https://github.com/novasvilla/kavverna"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'layer-shell-qt' 'kirigami' 'libpipewire' 'sqlite'
         'hicolor-icon-theme')
makedepends=('rust' 'clang' 'pkgconf')
# makepkg turns link time optimisation on by default, and it drops the symbols cxx-qt generates
# to bridge Rust and C++, so the binary fails to link with the whole bridge undefined.
options=('!lto')
optdepends=('ydotool: synthetic paste, once a feature asks for it')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1753651c842951c58d5b33421904f0ad3aad106eb2f8011216a1f18fbc3baf1b')

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen --locked
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Named by exclusion, or the list rots the next time a crate arrives or leaves. Anything
  # needing a live compositor, session bus or real sensors carries `#[ignore]`, none of which a
  # build chroot has.
  cargo test --frozen --release --workspace --exclude kavverna-shell
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/kavverna-shell "$pkgdir/usr/bin/kavverna-shell"
  install -Dm644 packaging/dev.kavverna.Kavverna.desktop \
    "$pkgdir/usr/share/applications/dev.kavverna.Kavverna.desktop"
  install -Dm644 docs/assets/logo.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.kavverna.Kavverna.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
